{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ValerianXXX/needradar/main/schemas/project-connection-v1.schema.json",
  "title": "NeedRadar Project Connection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "repository", "relationship", "connectionState", "runtimeIntegration", "evidenceBoundary", "needradar"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "relationship": {
      "enum": ["VALIDATION_METHOD", "REFERENCE_IMPLEMENTATION", "METHOD_INPUT", "APPLIES_PATTERN"]
    },
    "connectionState": {
      "enum": ["MANUAL_HANDOFF_READY", "DOCUMENTED_NO_RUNTIME_LINK"]
    },
    "runtimeIntegration": { "const": "NONE" },
    "accepts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "emits": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidenceBoundary": { "type": "string", "minLength": 20 },
    "needradar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystemUrl", "projectRegistry", "opportunityHandoffContract"],
      "properties": {
        "ecosystemUrl": { "type": "string", "format": "uri" },
        "projectRegistry": { "type": "string", "format": "uri" },
        "opportunityHandoffContract": { "type": "string", "format": "uri" }
      }
    }
  }
}
