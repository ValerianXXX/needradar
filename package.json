{
  "name": "needradar-portfolio",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "A curated, English-only portfolio edition of NeedRadar's evidence and publication policy.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:english": "node scripts/check-english.mjs",
    "test": "node --test tests/*.test.mjs",
    "eval:dedup": "node scripts/evaluate-dedup.mjs",
    "eval:boundaries": "node scripts/evaluate-boundaries.mjs",
    "eval:scale": "node --expose-gc scripts/benchmark-retrieval.mjs",
    "eval:boundary-pilot": "node scripts/evaluate-boundary-pilot.mjs",
    "eval:local-retrieval": "node --expose-gc scripts/evaluate-local-retrieval.mjs",
    "check": "npm run check:english && npm test"
  }
}
