# Optional direct public-brief review; never commit real values.
NEEDRADAR_ALLOW_CLOUD=false
OPENAI_API_KEY=
NEEDRADAR_MODEL=
# Optional trusted local command/Agent. Its own configuration may use cloud models.
NEEDRADAR_ALLOW_COMMAND=false
NEEDRADAR_REVIEW_EXECUTABLE=
NEEDRADAR_REVIEW_ARGS=[]
# Optional allowlisted experiment metadata, not credentials. The fixed pilot
# reads hermesRevision, pythonVersion, provider, configuredModel and verifiedAt.
NEEDRADAR_REVIEW_RUNTIME={}
# The 12-request pilot additionally requires --command and a fresh --output.
# No model, vector service or production deployment is activated by default.

# Optional CPU embeddings. Use a separate environment, never an Agent's Python.
# Downloads require the separate download-local-encoder.py --download command.
NEEDRADAR_ALLOW_LOCAL_ENCODER=false
NEEDRADAR_ENCODER_PYTHON=
NEEDRADAR_ENCODER_MODEL_DIR=

# Optional resumable reviews use explicit journalPath/reviewerRevision API options.
# There is no environment-triggered background worker or automatic retry. Store
# checkpoints outside this public checkout and keep them separate from human
# decisions. See docs/review-continuation-2026-10-29.md.

# The separately frozen targeted follow-up has 14 total attempts, seven per
# invocation and a two-failure stop. Its runtime metadata must match its plan.
# Replaying published observations needs none of these environment variables:
# node scripts/replay-targeted-followup.mjs

# Input consistency adds no environment-driven model access or retry. The optional
# isInputCurrent API callback is a synchronous caller revision check. See
# docs/review-input-consistency-2026-10-31.md. The historical live follow-up remains
# bound to its original product hashes; offline replay does not reopen that run.
